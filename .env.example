# Application
APP_NAME=ClothesSpot
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Optional AutoGen/OpenAI inference; disabled by default (local workflow stays offline).
AUTOGEN_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional LangSmith tracing (disabled unless enabled and a valid key is provided)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clothesspot-support-desk